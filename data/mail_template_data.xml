<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="email_template_agricultor_aprobado" model="mail.template">
            <field name="name">Bienvenida al Portal de Agricultores</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="subject">¡Tu cuenta ha sido aprobada!</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Hola <strong><t t-out="object.name or ''">Agricultor</t></strong>,<br/><br/>
                        ¡Buenas noticias! Tu cuenta en el portal de Pisterra ha sido revisada y validada por nuestro equipo.<br/><br/>
                        Ya tienes acceso total al sistema.<br/><br/>
                        ¡Bienvenido/a a la familia!
                    </p>
                </div>
            </field>
        </record>
    </data>
</odoo>