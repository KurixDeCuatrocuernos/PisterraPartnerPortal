<!-- Aquí va la navegación (navbar) de la vista -->
<odoo>
    <data>

    <!-- ACTIONS -->
        
        <!-- Redirección a Mis Envíos -->
        <record id="action_my_bookings" model="ir.actions.act_window">
            <field name="name">Mis Envíos</field>
            <field name="res_model">pisterra.unload.booking</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Redirección a Mis Facturas -->    
        <record id="action_my_invoices_url" model="ir.actions.act_url">
            <field name="name">Mis Facturas</field>
            <field name="url">/pisterra/invoices</field> <!-- Cambiar por el modelo de facturas -->
            <field name="target">self</field>
        </record>

        <!-- Redirección a Mi Inventario -->    
        <record id="action_my_inventory" model="ir.actions.act_window">
            <field name="name">Mi Inventario</field>
            <field name="res_model">stock.picking</field> <!-- Cambiar por el modelo de inventario -->
            <field name="view_mode">list,form</field> 
        </record>

    <!-- MENÚS -->

         <!-- MENÚ RAÍZ -->
        <menuitem id="menu_pisterra_root"
            name="Pisterra"
            action="action_my_bookings"
            sequence="10"/>

        <!-- MENÚ Mis Entregas DENTRO DE Pisterra -->
        <menuitem id="menu_my_bookings"
            name="Mis Envíos"
            parent="menu_pisterra_root"
            action="action_my_bookings"
            sequence="10"/>
        
        <!-- MENÚ Mis Facturas DENRO DE Pisterra -->
        <menuitem id="menu_my_invoices"
            name="Mis Facturas"
            parent="menu_pisterra_root"
            action="action_my_invoices_url"/>
        
        <!-- MENÚ Mi Inventario DENTRO DE Pisterra -->
        <menuitem id="menu_my_inventory"
            name="Mi Inventario"
            parent="menu_pisterra_root"
            action="action_my_bookings"
            sequence="10"/>
            
    </data>
</odoo>