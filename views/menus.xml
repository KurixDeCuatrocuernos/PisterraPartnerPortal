<!-- Aquí va la navegación (navbar) de la vista -->
<odoo>
    <data>

    <!-- ACTIONS -->
        
        <!-- Redirección a Dashboard -->
        <record id="action_dash_main" model="ir.actions.act_url">
            <field name="name">Inicio</field>
            <field name="url">/pisterra/dashboard</field>
            <field name="target">self</field>
        </record>

        <!-- Redirección a Mis Facturas -->    
        <record id="action_my_invoices_url" model="ir.actions.act_url">
            <field name="name">Mis Facturas</field>
            <field name="url">/pisterra/invoices</field>
            <field name="target">self</field>
        </record>

        <!-- Redirección a Mi Inventario -->    
        <record id="action_my_inventory" model="ir.actions.act_window">
            <field name="name">Mi Inventario</field>
            <field name="res_model">stock.picking</field>
            <field name="view_mode">list,form</field> 
        </record>

    <!-- MENÚS -->

        <!-- MENÚ RAÍZ (sin parent, aparece en el navbar principal) -->
        <menuitem id="menu_pisterra_root"
            name="Pisterra"
            sequence="10"/>

        <!-- MENÚ INICIAL (DASHBOARD) -->
        <menuitem id="menu_dashboard"
            name="Dashboard"
            parent="menu_pisterra_root"
            action="action_dash_main"
            sequence="10"/>
        
        <!-- MENÚ Mis Facturas -->
        <menuitem id="menu_my_invoices"
            name="Mis Facturas"
            parent="menu_pisterra_root"
            action="action_my_invoices_url"
            sequence="30"/>
        
        <!-- MENÚ Mi Inventario -->
        <menuitem id="menu_my_inventory"
            name="Mi Inventario"
            parent="menu_pisterra_root"
            action="action_my_inventory" 
            sequence="40"/>
            
    </data>
</odoo>