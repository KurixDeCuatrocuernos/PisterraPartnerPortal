<odoo>
    <data>
        <template id="entrega_portal_menu" inherit_id="portal.portal_my_home" priority="30">
            <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="title">Mis Entregas</t>
                    <t t-set="url" t-value="'/mis-entregas'"/>
                    <t t-set="placeholder_count" t-value="'delivery_count'"/>
                </t>
            </xpath>
        </template>

        <template id="entrega_list_template" name="Mis Entregas">
            <t t-call="portal.portal_layout">
                <t t-set="breadcrumbs_searchbar" t-value="True"/>
                
                <t t-call="portal.portal_searchbar">
                    <t t-set="title">Historial de Entregas</t>
                </t>

                <t t-if="not pickings">
                    <div class="alert alert-warning mt-4" role="alert">
                        No tienes entregas registradas en el sistema.
                    </div>
                </t>

                <t t-if="pickings">
                    <table class="table rounded mb-0 bg-white o_portal_my_doc_table mt-4">
                        <thead>
                            <tr class="active">
                                <th>Referencia</th>
                                <th>Fecha</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="pickings" t-as="picking">
                                <tr>
                                    <td>
                                      <a t-attf-href="/mis-entregas/#{picking.id}">
                                      <span t-field="picking.name"/>
                                      </a>
                                 </td>
                                    <td><span t-field="picking.scheduled_date" t-options='{"widget": "date"}'/></td>
                                    <td>
                                        <span class="badge badge-pill badge-info" t-field="picking.state"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </t>
            </t>
        </template>
        <template id="entrega_detail_template" name="Detalle de Entrega">
            <t t-call="portal.portal_layout">
                <t t-set="picking" t-value="picking"/>
                
                <div class="card mt-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h3>Albarán <span t-field="picking.name"/></h3>
                        <span t-attf-class="badge badge-pill #{'badge-success' if picking.state == 'done' else 'badge-info'}" t-field="picking.state"/>
                    </div>
                    <div class="card-body">
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <strong>Fecha de Recepción:</strong> <span t-field="picking.scheduled_date"/>
                            </div>
                        </div>
                        
                        <table class="table table-sm table-striped">
                            <thead class="bg-light">
                                <tr>
                                    <th>Producto</th>
                                    <th class="text-right">Cantidad</th>
                                    <th>Unidad</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="picking.move_ids_without_package" t-as="move">
                                    <tr>
                                        <td><span t-field="move.product_id.name"/></td>
                                        <td class="text-right"><span t-field="move.product_uom_qty"/></td>
                                        <td><span t-field="move.product_uom.name"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </t>
        </template>
    </data>
</odoo>