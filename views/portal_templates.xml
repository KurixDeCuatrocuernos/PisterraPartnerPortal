<!-- Aquí va la parte visual del proyecto -->
<odoo>
    <template id="portal_bookings_template">
        <t t-call="website.layout">
            <div class="container">
                <t t-foreach="bookings" t-as="b">
                    <div class="card">
                        <p>Date: <t t-esc="b.date"/></p>
                        <p>Slot: <t t-esc="b.slot"/></p>
                        <p>KG: <t t-esc="b.estimated_kg"/></p>
                        <p>Status: <t t-esc="b.status"/></p>
                    </div>
                </t>
            </div>
        </t>
    </template>
</odoo>