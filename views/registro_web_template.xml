<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="formulario_registro_template" name="Registro de Agricultores">
            
            <t t-call="website.layout">
                <div id="wrap" class="oe_structure oe_empty">
                    <section class="s_text_block pt40 pb40 o_colored_level">
                        <div class="container">
                            <div class="row justify-content-center">
                                <div class="col-lg-6 mt-4">
                                    <div class="card shadow-sm">
                                        <div class="card-header bg-primary text-white text-center">
                                            <h3 class="mb-0">Registro de Agricultores</h3>
                                        </div>
                                        <div class="card-body p-4">
                                            
                                            <form action="/registro/enviar" method="POST">
                                                
                                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                
                                                <div class="mb-3">
                                                    <label for="nombre" class="form-label">Nombre o Razón Social</label>
                                                    <input type="text" class="form-control" id="nombre" name="nombre" required="1" placeholder="Ej: Finca Los Robles"/>
                                                </div>
                                                
                                                <div class="mb-3">
                                                    <label for="correo" class="form-label">Correo Electrónico</label>
                                                    <input type="email" class="form-control" id="correo" name="correo" required="1" placeholder="ejemplo@correo.com"/>
                                                </div>

                                                <div class="mb-3">
                                                    <label for="password" class="form-label">Contraseña</label>
                                                    <input type="password" class="form-control" id="password" name="password" required="1" placeholder="Crea una contraseña segura"/>
                                                </div>
                                                
                                                <div class="d-grid mt-4">
                                                    <button type="submit" class="btn btn-primary btn-lg">Solicitar Registro</button>
                                                </div>
                                                
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </t>
        </template>

        <template id="registro_completado_template" name="Registro Completado">
            <t t-call="website.layout">
                <div id="wrap" class="oe_structure oe_empty">
                    <section class="s_text_block pt80 pb80 text-center">
                        <div class="container">
                            <i class="fa fa-check-circle fa-5x text-success mb-4"></i>
                            <h1 class="display-4">¡Registro completado!</h1>
                            <p class="lead mt-3">Tu cuenta está en pausa hasta que un administrador la valide. Te avisaremos por correo electrónico.</p>
                            <a href="/" class="btn btn-primary mt-4">Volver al inicio</a>
                        </div>
                    </section>
                </div>
            </t>
        </template>

    </data>
</odoo>