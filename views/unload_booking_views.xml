<!-- Este documento es para mostrar el pedido/envío en el backend -->
<odoo>
    <data>

        <record id="view_unload_booking_tree" model="ir.ui.view">
            <field name="name">unload.booking.tree</field>
            <field name="model">pisterra.unload.booking</field>
            <field name="arch" type="xml">
                <list>
                    <field name="date"/>
                    <field name="slot"/>
                    <field name="estimated_kg"/>
                    <field name="status"/>
                </list>
            </field>        
        </record>

    </data>
</odoo>